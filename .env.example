# Copie este arquivo para ".env" e preencha os valores.
# O arquivo .env NUNCA deve ir para o GitHub (ele já está no .gitignore).

# Chave secreta do Django. Obrigatória em produção.
# Para gerar uma: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=

# True apenas no desenvolvimento local.
DEBUG=True

# Endereços aceitos pelo site, separados por vírgula.
ALLOWED_HOSTS=localhost,127.0.0.1

# Em produção com domínio próprio, ex.: https://matricula.exemplo.org
CSRF_TRUSTED_ORIGINS=

# Banco de dados. Deixe vazio para usar SQLite no desenvolvimento local.
# Com o PostgreSQL do docker-compose: postgres://sementes:SUA_SENHA@localhost:5432/sementes
DATABASE_URL=

# Endereço do painel admin do Django (troque em produção).
ADMIN_URL=admin/

# Contato exibido na página de privacidade (e-mail ou telefone da ONG).
CONTATO_PRIVACIDADE=

# Usadas somente pelo docker-compose para criar o PostgreSQL local.
POSTGRES_DB=sementes
POSTGRES_USER=sementes
POSTGRES_PASSWORD=
